# copy to .env and adjust; every value has a working local default

# shared
VF_SERVICE_TOKEN=dev-token-change-me
VF_MASTER_KEY=dev-master-key-change-me

# service URLs (used for service-to-service calls)
LENS_URL=http://localhost:8086
KEYCHAIN_URL=http://localhost:8087
VAULT_URL=http://localhost:8085
ROUTER_URL=http://localhost:8089
APEX_URL=http://localhost:8080
FORGE_URL=http://localhost:8000
CRAWLER_URL=http://localhost:3000

# apex
VF_RATE_LIMIT=60
VF_RATE_WINDOW_S=60

# forge
VF_FORGE_TIMEOUT_S=60

# crawler
VF_CRAWLER_ROBOTS=1
VF_CRAWLER_ALLOW_PRIVATE=0

# panel
PORT=5173
